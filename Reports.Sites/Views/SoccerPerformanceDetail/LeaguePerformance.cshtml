<div id="divLeaguePerformanceContainer" class="content-grid display-none">
    <div id="divLeaguePerformanceGrid" class="freegrid"></div>
</div>
<div id="divTraderPerformanceContainer" class="content-grid display-none">
    <div id="divTraderPerformanceGrid" class="freegrid"></div>
</div>
<div id="divMatchPerformanceContainer" class="content-grid display-none">
    <div id="divMatchPerformanceGrid" class="freegrid"></div>
</div>
<div id="divBettypeDetailContainer" class="content-grid display-none">
    <div id="divBettypeDetailGrid" class="freegrid"></div>
</div>
<div id="divMatchPerformanceOfLeagueContainer" class="content-grid display-none">
    <div id="divMatchPerformanceOfLeagueGrid" class="freegrid"></div>
</div>
<div id="divBettypePerformanceOfLeagueMatchContainer" class="content-grid display-none">
    <div id="divBettypePerformanceOfLeagueMatchGrid" class="freegrid"></div>
