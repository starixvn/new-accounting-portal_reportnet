@using Microsoft.AspNetCore.Mvc.TagHelpers
@using TGR
@using TGR.ViewModel
@using Utilities.DateTimes
@{
	ViewBag.Title = "Soccer Performance Detail";
	Layout = "~/Views/Shared/_OldLayout.cshtml";
}
@{
	Dictionary<Market, string> markets = ViewBag.Markets;
	var isDisableMarket = markets.Count == 1;
}
@section Head
{
    <link rel="stylesheet" type="text/css" href="~/tgrs/styles/common.css?v=2" />
    <link rel="stylesheet" type="text/css" href="~/style/month-picker.css" />
    <link rel="stylesheet" type="text/css" href="~/style/month-picker-custom.css" />
    <link rel="stylesheet" type="text/css" href="~/style/nex-date-picker.css" />
    <link rel="stylesheet" type="text/css" href="~/style/pager-pagination.css" />
    <link rel="stylesheet" type="text/css" href="~/style/fanex-grid.css" />
    <link rel="stylesheet" type="text/css" href="~/soccer-performance-detail/styles/performance-detail.css" />
}
@section Headline
{
    <div class="title">
		<div>
			<span>TGR / </span><span class="curr">@ViewBag.Title</span>
		</div>
	</div>
	<div class="header-button">
		<a href="@Url.Content("~/SoccerPerformanceDetail/LeaguePerformance")" class="green-button change-list">
			<span class="list-icon"></span>League
		</a>
		<a href="#" class="green-button change-list disabled">
			<span class="list-icon"></span>Trader
		</a>
		<a href="@Url.Content("~/SoccerPerformanceDetail/GradePerformance")" class="green-button change-list">
			<span class="list-icon"></span>Grade
		</a>
		<a href="@Url.Content("~/SoccerPerformanceDetail/TeamPerformance")" class="green-button change-list">
			<span class="list-icon"></span>Team
		</a>
		<a href="@Url.Content("~/SoccerPerformanceDetail/BetTypePerformance")" class="green-button change-list">
			<span class="list-icon"></span>BetType
		</a>
	</div>
	<div class="server-time">
		<span>GMT-4</span>
	</div>
}
<div class="filter-bar">
    <div id="divTraderPerformanceFilter" class="filter-form">
        <div class="filter-row">
            <div class="lbl-field col_6">
                <label>Market</label>
            </div>
            <div class="edit-field col_5">
                <select id="ddlMarket" disabled="@isDisableMarket" style="width: 10.5em">
                    @foreach (var item in markets)
                    {
                        <option value="@item.Key">@item.Value</option>
                    }
                </select>
            </div>
            <div class="date-range" style="width:655px"><div class="lbl-field" style="width:25px"></div><div id="divDateRange"></div></div>
            <div class="lbl-field col_4" style="width:102px">
                <label for="ddlBetType">BetType</label>
            </div>
            <div class="edit-field col_8">
                <select id="ddlBetType" multiple="multiple" style="width: 160px">
                    @foreach (var group in (IEnumerable<GroupBetTypes>)ViewBag.GroupBetTypes)
                    {
                        bool check = group.TotalDefaultCheckOfBetTypeList == group.BetTypeList.Count();
                        <optgroup label="@group.GroupName" checked=@check>
                            @foreach (var bettype in (IEnumerable<BetType>)group.BetTypeList)
                            {
                                <option value="@bettype.BetTypeId" data-default="@bettype.IsDefaultCheck">@bettype.BetTypeName</option>
                            }

                        </optgroup>
                    }
                </select>
            </div>
        </div>


        <div class="filter-row">
            <div class="lbl-field col_6">
                <label for="txtLeague">League Group</label>
            </div>
            <div class="edit-field col_5">
	            <select id="ddlLeagueGroup" multiple="multiple">
		            @foreach (var leagueGroup in (IEnumerable<LeagueGroup>)ViewBag.LeagueGroups)
		            {
			            <option value=@leagueGroup.TargetLeagueGroupId selected>@leagueGroup.LeagueGroupName</option>
		            }
	            </select>
            </div>
            <div class="lbl-field col_6" style="margin-left: 12px">
	            <label for="ddlMatchGroup">Match Group</label>
            </div>
            <div class="edit-field col_6">
	            <select id="ddlMatchGroup" multiple="multiple">
                    <option value="EXTRA_TIME" selected>Extra Time</option>
                    <option value="NORMAL" selected>Normal</option>
                    <option value="PENALTY" selected>Penalty</option>
		            <option value="HEDGE" selected>Hedge</option>
	            </select>
            </div>
            <div class="lbl-field col_17">
	            <label for="ddlVrSettings">VR Setting</label>
            </div>
            <div class="edit-field col_6">
	            <select id="ddlVrSettings" multiple="multiple">
                    <option value="VR_PLUS" selected>VR+</option>
                    <option value="NO_VR" selected>No VR</option>
                    <option value="VR_MINUS" selected>VR-</option>
	            </select>
            </div>
        </div>
        <div class="filter-row">
	        <div class="lbl-field col_6">
		        <label for="txtTrader">Trader</label>
	        </div>
            <div class="edit-field col_5 align-left">
                <input type="text" id="txtTrader" maxlength="30" style="width: 130px" />
            </div>
        </div>
		
        <div class="filter-row">
	        <div class="lbl-field col_6">
		        &nbsp;
	        </div>
	        <div class="edit-field col_5">
                <input id="btnGenerate" type="button" class="blue-button" value="Generate" />
	        </div>
        </div>

    </div>
</div>
<div id="divTraderPerformanceContainer" class="content-grid display-none">
    <div id="divTraderPerformanceGrid" class="freegrid"></div>
</div>
<div id="divMatchPerformanceContainer" class="content-grid display-none">
    <div id="divMatchPerformanceGrid" class="freegrid"></div>
</div>
<div id="divBettypeDetailContainer" class="content-grid display-none">
    <div id="divBettypeDetailGrid" class="freegrid"></div>
</div>
@section Foot
{
    <script type="text/javascript" src="~/scripts/_lib/Namespace.js"></script>
	<script type="text/javascript" src="~/scripts/tgrs/common-tgrs.js?v=3"></script>
	<script type="text/javascript" src="~/scripts/tgrs/tgrs.js"></script>
	<script type="text/javascript" src="~/scripts/msg-box.js"></script>
    <script type="text/javascript" src="~/scripts/trader-performance.js?v=20250702"></script>
    <script type="text/javascript">
        var datepickerSetting = {
            MinDate: '@(((DateTime)ViewBag.MinDate).ToShortFormatedDate())',
            DefaultFromDate: '@(((DateTime)ViewBag.DefaultFromDate).ToShortFormatedDate())',
            DefaultToDate: '@(((DateTime)ViewBag.DefaultToDate).ToShortFormatedDate())',
            AllowYearRange: parseInt('@ViewBag.AllowYearRange')
        };
        var forecastBettype = '@ViewBag.ForecastBetType';
        var labels = {
            MarketNonLive: 'Non-Live',
            MarketLive: 'Live',
            No: '#',
            NoOfLeagues: 'No. Of Leagues',
            NoOfMatches: 'No. Of Matches',
            Turnover: 'Turnover',
            AvgTurnoverPerMatch: 'Avg. TO Per Match',
            WinLoss: 'Win Loss',
            BetCount: 'Bet Count',
            BetTypeBM: 'Bet Type BM %',
            BetType: 'Bet Type',
            BetTypeDetail: 'Bet Type Detail',
            Margin: 'Margin %',
            Trader: 'Trader',
            Grade: 'Grade',
            Team: 'Team',
            Match: 'Match',
            Total: 'Total',
            GrandTotal: 'Grand Total',
            AllBetTypes: 'All',
            EventDate: 'Event Date',
            EffectiveDate: 'Effective Date',
            AllLeagueGroups: 'All',
            NA: 'N/A',
            Forecast: 'Forecast',
            TraderPerformance: 'Trader Performance',
            MatchPerformance: 'Match Performance',
            TeamHistoryDetail: 'Team History Detail',
            GradeHistoryDetail: 'Grade History Detail',
            Score: 'Score',
            Benchmark: 'BM %',
            ScoreByLatestBenchMark: 'Score By Latest BM',
            ScoreByPeriod: 'Score By Period'
        };

        var messages = {
            InvalidValue: 'Invalid value!',
            RequiredField: 'Invalid value!'
        };

        var isVirtualPerformancePermission = '@ViewBag.IsVirtualPerformancePermission' == "True";
        var isRealPerformancePermission = '@ViewBag.IsRealPerformancePermission' == "True";
        var isExcludeLeagues = '@ViewBag.IsExcludeLeagues' === 'True';
    </script>
}