	<script type="text/javascript" src="~/scripts/tgrs/tgrs.js"></script>
	<script type="text/javascript" src="~/scripts/msg-box.js"></script>
	<script type="text/javascript" src="~/scripts/bettype-performance.js"></script>
    <script type="text/javascript">
        var datepickerSetting = {
