@using SoccerPerformanceDetail.ViewModel
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using SoccerPerformanceDetail
@using Utilities.DateTimes
@{
    ViewBag.Title = "Soccer Performance Detail";
	Layout = "~/Views/Shared/_OldLayout.cshtml";
}
@{
    Dictionary<Market, string> markets = ViewBag.Markets;
    var isDisableMarket = markets.Count == 1;
}
@section Head
{
	
	<link rel="stylesheet" type="text/css" href="~/tgrs/styles/common.css?v=1" />
	<link rel="stylesheet" type="text/css" href="~/stylesheets/datepicker/jquery.nexDatePicker.css" />
	<link rel="stylesheet" type="text/css" href="~/style/pager-pagination.css" />
	<link rel="stylesheet" type="text/css" href="~/style/fanex-grid.css" />
	<link rel="stylesheet" type="text/css" href="~/soccer-performance-detail/styles/performance-detail.css" />
}
@section Headline
{
	<div class="title">
		<div>
			<span>TGR / </span><span class="curr">@ViewBag.Title</span>
		</div>
	</div>
	<div class="header-button">
		<a href="#" class="green-button change-list disabled">
			<span class="list-icon"></span>BetType
		</a>
	</div>
}
<div class="filter-bar">
    <div id="divBetTypePerformanceFilter" class="filter-form">
        <div class="filter-row">
            <div class="lbl-field col_6">
                <label>Market</label>
            </div>
            <div class="edit-field col_5">
                <select id="ddlMarket" disabled="@isDisableMarket" style="width: 10.5em">
                    @foreach (KeyValuePair<Market, string> item in markets)
                    {
                        <option value="@item.Key">@item.Value</option>
                    }
                </select>
            </div>
            <div class="date-range"><div class="lbl-field" style="width:25px"></div><div id="divDateRange"></div></div>
            <div class="lbl-field col_4">
                <label for="ddlBetType">BetType</label>
            </div>
            <div class="edit-field col_8">
                <select id="ddlBetType" multiple="multiple" style="width: 160px">
                    @foreach (var group in (IEnumerable<GroupBetTypes>)ViewBag.GroupBetTypes)
                    {
	                    var check = group.TotalDefaultCheckOfBetTypeList == group.BetTypeList.Count();
	                    <optgroup label="@group.GroupName" checked=@check>
		                    @foreach (var bettype in (IEnumerable<BetType>)group.BetTypeList)
		                    {
			                    <option value="@bettype.BetTypeId" data-default="@bettype.IsDefaultCheck">@bettype.BetTypeName</option>
		                    }
	                    </optgroup>
                    }
                </select>
            </div>
        </div>
        <div class="filter-row">
            @if (@ViewBag.IsVirtualPerformancePermission)
            {
                <!-- Virtual -->
                <div class="lbl-field col_6">
                    <label for="txtMinTurnover">Minimum Virtual Turnover</label>
                </div>
                <div class="edit-field col_5">
                    <input type="text" id="txtMinTurnover" style="width:10em" maxlength="10" data-val-number="Invalid value!" />
                </div>
                <div class="lbl-field col_6 min-winloss">
                    <label for="txtMinWinLoss">Minimum Virtual WinLoss</label>
                </div>
                <div class="edit-field col_5">
                    <input type="text" id="txtMinWinLoss" maxlength="10" data-val-number="Invalid value!" />
                </div>
                <div class="lbl-field col_6 margin">
                    <label for="txtMarginFrom">Virtual Margin %</label>
                </div>
                <div class="edit-field col_12">
                    <input type="text" id="txtMarginFrom" class="margin" maxlength="5" data-val-number="Invalid value!" />
                    <span> - </span>
                    <input type="text" id="txtMarginTo" class="margin" maxlength="5" data-val-number="Invalid value!" />
                </div>
                <!-- Virtual end -->
            }

        </div>
        <div class="filter-row">
            @if (@ViewBag.IsRealPerformancePermission)
            {
                <!-- Real -->
                <div class="lbl-field col_6">
                    <label for="txtMinTurnoverReal">Minimum Real Turnover</label>
                </div>
                <div class="edit-field col_5">
                    <input type="text" id="txtMinTurnoverReal" style="width:10em" maxlength="10" data-val-number="Invalid value!" />
                </div>
                <div class="lbl-field col_6 min-winloss">
                    <label for="txtMinWinLossReal">Minimum Real WinLoss</label>
                </div>
                <div class="edit-field col_5">
                    <input type="text" id="txtMinWinLossReal" maxlength="10" data-val-number="Invalid value!" />
                </div>
                <div class="lbl-field col_6 margin">
                    <label for="txtMarginFromReal">Real Margin %</label>
                </div>
                <div class="edit-field col_12">
                    <input type="text" id="txtMarginFromReal" class="margin" maxlength="5" data-val-number="Invalid value!" />
                    <span> - </span>
                    <input type="text" id="txtMarginToReal" class="margin" maxlength="5" data-val-number="Invalid value!" />
                </div>
                <!-- Real end -->
            }
        </div>
        <div class="filter-row">
            <div class="lbl-field col_6">
                <label for="txtLeague">League Group</label>
            </div>
            <div class="edit-field col_5">
                <select id="ddlLeagueGroup" multiple="multiple">
                    @foreach (var leagueGroup in (IEnumerable<LeagueGroup>)ViewBag.LeagueGroups)
                    {
                        <option value=@leagueGroup.TargetLeagueGroupId selected>@leagueGroup.LeagueGroupName</option>
                    }
                </select>
            </div>
            <div class="lbl-field col_5" style="width: 159px">
                <label for="txtLeague">League</label>
            </div>
            <div class="edit-field col_5">
                <input type="text" id="txtLeague" maxlength="100" />
            </div>

            <div class="lbl-field col_3 bettype-bm"></div>
            <div class="submit width-auto col_4">
                <input id="btnGenerate" type="button" class="blue-button bettype-generate" value="Generate" />
            </div>
        </div>
    </div>
</div>
<div id="divBetTypePerformanceContainer" class="content-grid display-none">
    <div id="divBetTypePerformanceGrid" class="freegrid"></div>
</div>

<div id="divBetChoicePerformanceContainer" class="content-grid display-none">
    <div id="divBetChoicePerformanceGrid" class="freegrid"></div>
</div>

<div id="divTraderPerformanceContainer" class="content-grid display-none">
    <div id="divTraderPerformanceGrid" class="freegrid"></div>
</div>

<div id="divMatchPerformanceContainer" class="content-grid display-none">
    <div id="divMatchPerformanceGrid" class="freegrid"></div>
</div>

<div id="divLeaguePerformanceContainer" class="content-grid display-none">
    <div id="divLeaguePerformanceGrid" class="freegrid"></div>
</div>

<div id="divIntervalBetChoicePerformanceContainer" class="content-grid display-none">
    <div id="divIntervalBetChoicePerformanceGrid" class="freegrid"></div>
</div>

<div id="divPointHDPPerformanceContainer" class="content-grid display-none">
    <div id="divPointHDPPerformanceGrid" class="freegrid"></div>
</div>

<div id="divTimeMachinePerformanceContainer" class="content-grid display-none">
    <div id="divTimeMachinePerformanceGrid" class="freegrid"></div>
</div>

