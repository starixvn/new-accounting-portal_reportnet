@inject IConfiguration configuration
@{
	var baseHref = @"/";
}
<!doctype html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<base href="@baseHref">
	<link rel="icon" type="image/x-icon" href="@Url.Content("favicon.ico")">
	<title>@Html.Raw(ViewBag.Title)</title>
	@RenderSection("Head", false)
</head>
<body>
	@RenderBody()
	<script src="@Url.Content("~/auth/recheckinscript")" type="text/javascript"></script>
    @if (!Context.User.Identity.Name.Contains("starix") && configuration.GetSection("Fanex.NAP.Client:Environment").Value =="LIVE")
	{
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-1MDEJEL4L2"></script>
		<script>
			window.dataLayer = window.dataLayer || [];
			function gtag(){
				dataLayer.push(arguments);
			}
			gtag('js', new Date());
			gtag('config', 'G-1MDEJEL4L2');
			gtag('username', '@Context.User.Identity.Name');
        </script>
	}
</body>
</html>