@{
	var baseHref = @"/";
}
<!doctype html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<base href="@baseHref">
	<link rel="icon" type="image/x-icon" href="@Url.Content("favicon.ico")">
	<title>@Html.Raw(ViewBag.Title)</title>
	@RenderSection("Head", false)
</head>
<body>
	@RenderBody()
	<script src="@Url.Content("~/auth/recheckinscript")" type="text/javascript"></script>
	<!-- Google tag (gtag.js) -->
	<script async src="https://www.googletagmanager.com/gtag/js?id=G-WTBZ86ET8V"></script>
	<script>
		window.dataLayer = window.dataLayer || [];
		function gtag(){
			dataLayer.push(arguments);
		}
		gtag('js', new Date());
		gtag('config', 'G-WTBZ86ET8V');
		gtag('username', @Context.User.Identity.Name);
	</script>
</body>
</html>