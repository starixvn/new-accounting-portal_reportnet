@{
    ViewBag.Title = "Company Win Loss";
    Layout = "~/Views/Shared/_OldLayout.cshtml";
}
@section Head {
    <link rel="stylesheet" type="text/css" href="~/style/jquery-multiselect.css" />
    <link rel="stylesheet" type="text/css" href="~/style/month-picker.css" />
    <link rel="stylesheet" type="text/css" href="~/style/month-picker-custom.css" />
    <link rel="stylesheet" type="text/css" href="~/style/fanex-grid-paging.css" />
    <link rel="stylesheet" type="text/css" href="~/style/nex-date-picker.css" />
    <link rel="stylesheet" type="text/css" href="~/style/fanex-grid.css" />
    <link rel="stylesheet" type="text/css" href="~/company-win-loss/styles/index.css" />
}
@section Headline {
    <div class="title">
        <div>
            <span>Licensee / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div id="filter-bar">
    <span id="notemessage" class="note-info-message" title=''></span>
    <div class="filter-form">
        <div class="filter-row">
            <div class="filter-cell">
                <div class="lbl-field col_3 align-right">
                    Month
                </div>
                <div class="edit-field col_5">
                    <div id="dvMonth">
                    </div>
                </div>
                <div class="lbl-field col_4 align-right">
                    Licensee
                </div>
                <div class="edit-field col_8">
                    <div id="dvLicensee">
                        <select id="ddlLicensee"></select>
                    </div>
                </div>
                <div class="lbl-field col_3 align-right">
                    Currency
                </div>
                <div class="edit-field col_5">
                    <div id="dvCurrency">
                        <select id="ddlCurrency"></select>
                    </div>
                </div>
                <div class="lbl-field col_3 align-right">
                    Product
                </div>
                <div class="edit-field col_5">
                    <div id="dvProduct">
                        <select id="ddlProduct"></select>
                    </div>
                </div>
                <div class="submit width-auto col_4 prefix_5">
                    <input id="btnGenerate" name="btnGenerate" type="submit" value="GENERATE" />
                </div>
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-cell">
                <div id="ErrMsg" class="col_35 display-none width-auto">
                </div>
            </div>
        </div>
    </div>
</div>

<div id="reportContainer" class="content-grid display-none">
    <div id="reportContent" class="freegrid display-none">
    </div>
</div>

@section scripts
{
    <script type="text/javascript">
        var today = '@DateTime.Today.ToShortDateString()';
        var minDate = '@(new DateTime(2015, 06, 1))';
    </script>
}
@section Foot {
    <script type="text/javascript" src="~/scripts/jquery-multiselect.js"></script>
    <script type="text/javascript" src="~/scripts/month-picker.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/Namespace.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/FormatLibs/DateTimeFormat/moment.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/PopUp/dialogbox.js"></script>
    <script type="text/javascript" src="~/company-win-loss/scripts/Index.js?v=1"></script>
}