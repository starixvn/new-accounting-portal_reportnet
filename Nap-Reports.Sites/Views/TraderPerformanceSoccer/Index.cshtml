@using Utilities.Resources
@{
    ViewBag.Title = "Trader Performance Soccer";
    Layout = "~/Views/Shared/_OldLayout.cshtml";
}
@section Head {
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/DatePicker/jquery.nexDatePicker.css" />
    <link rel="stylesheet" type="text/css" href="~/style/pager-pagination.css" />
    <link rel="stylesheet" type="text/css" href="~/style/fanex-grid.css" />
    <link rel="stylesheet" type="text/css" href="~/style/scrollbars.css" />
    <link rel="stylesheet" type="text/css" href="~/trader-performance/styles/trader-performance-soccer.css" />
}
@section Headline {
    <div class="title">
        <div>
            <span>Main / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div id="filter-bar">
    <div class="filter-form">
        <div class="filter-row">
            <div class="filter-cell">
                <div id="datepickerplugin" class="lbl-field col_15 align-right">
                </div>
                <div class="submit width-auto col_4">
                    <input id="btnGenerate" name="btnGenerate" type="submit" value="Soccer" class="col_5 alpha" />
                    <input id="btnDetailReport" name="btnDetailReport" type="submit" value="Soccer Detail" class="col_5 omega" />
                    <input id="btnSummarylReport" name="btnSummarylReport" type="submit" value="Soccer Summary" class="col_6 omega display-none" />
                    <input id="btnSummaryPH" name="btnSummaryPH" type="submit" value="Soccer PH" class="col_5 omega" />
                    <input id="btnDetailPH" name="btnDetailPH" type="submit" value="Soccer PH Detail" class="col_6 omega" />
                </div>
            </div>
        </div>
    </div>
</div>
<div id="parentContainer" class="content-grid">
    <div id="soccerReportContainer" class="display-none">
    <div id="soccerReportHeader" class="grid-title display-none">
