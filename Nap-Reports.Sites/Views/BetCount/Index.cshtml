@section scripts
{
    <script type="text/javascript">
        var noteMessage = '@Html.Raw("Data is only available from last 3 months up to yesterday (after 11AM GMT-4). For more historical data, please click <span class=\"bold-tip\">HISTORY REPORT</span>")';
        var labelFrom = 'From';
        var labelTo = 'To';
        var today = '@DateTime.Today.ToShortDateString()';
        var mindate = new Date('@DateTime.Now.FirstDayOfMonth().AddMonths(-3).ToString()');
        var minHistoryReportDate = new Date(2009, 1, 1);
    </script>
}
