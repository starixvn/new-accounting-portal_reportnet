            <span>Misc / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div id="filter-bar">
    <span id="notemessage" class="note-info-message" title=''></span>
    <div class="filter-form">
        <div id="betCountReportFilter">
            <div class="filter-row">
                <div class="filter-cell">
                    <div id="datepickerplugin" class="lbl-field col_23 align-right">
                    </div>
                </div>
            </div>
            <div class="filter-row">
                <div class="filter-cell">
                    <div class="lbl-field col_2 align-right">
                        Product
                    </div>
                    <div class="edit-field  col_7 align-left ddlProductContainer">
                        <select id="ddlProduct">
                        </select>
                    </div>
                    <div class="lbl-field col_3 align-right">
                        Sport
                    </div>
                    <div class="edit-field col_7 align-left">
                        <select id="ddlSport">
                        </select>
                    </div>
                    <div class="submit col_6 prefix_2">
                        <input id="btnGenerate" name="btnGenerate" type="submit" value="GENERATE" />
                    </div>
                    <div class="submit col_6 prefix_1">
                        <input id="btnViewHistoryReport" name="btnViewHistoryReport" type="submit" value="HISTORY REPORT" />
                    </div>
                </div>
            </div>
        </div>
        <div id="historyBetCountReportFilter" class="display-none">
