@{
    @inject IJsonHelper Json;
    ViewBag.Title = "Daily Win Loss (2h) Soccer Minor Bet Types";
    ViewBag.AngularAppName = "houseWinlossApp";
}

<div class="page-header">
    Main / <span class="active">@ViewBag.Title</span>
</div>
<div data-ng-view></div>
<div data-nap-alert></div>
<div data-nap-loading></div>
@section Styles{
     <link href="~/bundle/app-style.css" rel="stylesheet" />
    <link href="~/bundle/house-win-loss-style.css" rel="stylesheet" />
}
@section Scripts{
    <script src="~/bundle/lib.chunk.js"></script>
    <script src="~/bundle/app.chunk.js"></script>
    <script src="~/bundle/daily-winloss-2h-soccer-minor.chunk.js"></script>
}

<script type="text/javascript">
    var modePermissions = @Html.Raw(Json.Serialize(ViewBag.ModePermissions));
    var productPermissions =@Html.Raw(Json.Serialize(ViewBag.ProductPermissions));
</script>