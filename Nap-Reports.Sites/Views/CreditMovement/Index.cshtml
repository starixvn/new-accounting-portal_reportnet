@using Utilities.DateTimes
@{
    ViewBag.Title = "Credit Movement Monitor";
    Layout = "~/Views/Shared/_OldLayout.cshtml";
}
@section Head {
    <link rel="stylesheet" type="text/css" href="~/style/month-picker.css" />
    <link rel="stylesheet" type="text/css" href="~/style/month-picker-custom.css" />
    <link rel="stylesheet" type="text/css" href="~/style/nex-date-picker.css" />
    <link rel="stylesheet" type="text/css" href="~/style/jquery-multiselect.css" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/Fanex.Multiselect/fanex.multiSelect.css" />
    <link rel="stylesheet" type="text/css" href="~/style/fanex-grid-paging.css" />
    <link rel="stylesheet" type="text/css" href="~/style/fanex-grid.css" />
}
<style type="text/css">
    .ddlSite .fanex-multiselect-state-default {
        width: 250px !important;
    }
</style>
@section Headline {
    <div class="title">
        <div>
            <span>Misc / </span><span class="curr">@ViewBag.Title</span>
        </div>
    </div>
}
<div id="filter-bar">
    <div class="filter-form">
        <div class="filter-row">
            <div class="filter-cell">
                <div id="datepickerplugin" class="lbl-field col_15 align-right">
                </div>
            </div>
            <div class="filter-cell">
                <div class="lbl-field col_1 align-right">
                    Site
                </div>
                <div class="edit-field col_11 align-left ddlSite">
                    <select id="ddlSite"></select>
                </div>
            </div>
            <div class="filter-cell">
                <div class="lbl-field col_2 align-right">
                    Amount
                </div>
                <div class="edit-field col_5 align-left">
                    <input type="text" id="txtAmount" maxlength="11" value="@ViewBag.Amount" class="numberic-textbox" />
                </div>
                <div class="lbl-field col_1 align-left">
                    (RM)
                </div>
            </div>
            <div class="filter-cell">
                <div class="submit width-auto col_4 prefix_2">
                    <input id="btnGenerate" name="btnGenerate" type="submit" value="Generate" />
                </div>
            </div>
        </div>
    </div>
</div>
<div id="reportContainer" class="content-grid display-none">
    <div id="reportContent" class="freegrid display-none">
    </div>
</div>

@{
    var lastMonth = DateTime.Now.AddMonths(-1);
    var firtDateOfLastMonth = new DateTime(lastMonth.Year, lastMonth.Month, 1).ToShortFormatedDate();
}
@section scripts
{
    <script type="text/javascript">
        var labelFrom = 'From';
        var labelTo = 'To';
        var today = '@DateTime.Today.ToShortFormatedDate()';
        var minDate = '@firtDateOfLastMonth';
        var lasweek = '@DateTime.Today.AddDays(-7).ToShortFormatedDate()';
    </script>
}
@section Foot {
    <script type="text/javascript" src="~/scripts/_lib/Namespace.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/FormatLibs/DateTimeFormat/moment.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/DatePicker/jquery.nexDatePicker.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/MonthPicker/monPickr-0.0.3.min.js?ver=10"></script>
    <script type="text/javascript" src="~/scripts/_lib/Fanex.Multiselect/fanex.multiSelect.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/NumericTextBox/jquery.setcaretposition.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/NumericTextBox/jquery.caret.1.02.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/NumericTextBox/jquery.formattyping.js"></script>
    <script type="text/javascript" src="~/credit-movement/scripts/CreditMovement.js"></script>
}
