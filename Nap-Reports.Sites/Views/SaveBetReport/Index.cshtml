@{
	ViewBag.Title = "Save Bet";
	Layout = "~/Views/Shared/_OldLayout.cshtml";
}
@section Head {
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/DatePicker/jquery.nexDatePicker.css" />
    <link rel="stylesheet" type="text/css" href="~/scripts/_lib/Fanex.Grid/Fanex.Pagination.css" />
    <link rel="stylesheet" type="text/css" href="~/style/scrollbars.css" />
    <link rel="stylesheet" type="text/css" href="~/style/pager-pagination.css" />
    <link rel="stylesheet" type="text/css" href="~/style/fanex-grid.css" />
    <link rel="stylesheet" type="text/css" href="~/save-bet/styles/save-bet.css">
}
@section Headline {
	<div class="title">
		<div>
			<span>Fraud & Risk  / </span><span class="curr">@ViewBag.Title</span>
		</div>
	</div>
}
<div id="filter-bar">
    <div class="filter-form">
        <div id="matchSelectionFilter">
            <div class="filter-row">
                <div class="filter-cell">
                    <div id="datepickerplugin" class="lbl-field col_8 align-right">
                    </div>
                </div>
                <div id="sportContainer" class="sportContainer display-none">
                    <div class="lbl-field align-right col_2">Sport</div>
                    <div class="edit-field col_8">
                        <select id="ddlSport" class="ddlSport">
                        </select>
                    </div>
                    <div class="clear-both"></div>
                </div>
                <div id="leagueContainer" class="leagueContainer display-none">
                    <div class="lbl-field align-right col_2">League</div>
                    <div class="edit-field col_16">
                        <select id="ddlLeague" class="ddlLeague">
                        </select>
                    </div>
                    <div class="clear-both"></div>
                </div>
                <div id="generateBtnContainer" class="submit col_4 display-none">
                    <input id="btnGenerate" name="btnGenerate" type="submit" value="GENERATE" />
                </div>
                <div id="noneSportAndLeagueMsg" class="display-none noneSportAndLeagueMsg">
                </div>
            </div>
        </div>
    </div>
</div>
<div class="content-grid display-inline-block">
    <div id="saveBetReportContainer" class="display-none">
        <div id="saveBetReport" class="freegrid display-none">
        </div>
    </div>
</div>
@section scripts
{
    <script type="text/javascript">
        var labelDate = 'Date';
        var today = '@DateTime.Today.ToShortDateString()';
        var minDate = '@DateTime.Today.AddMonths(-3).ToShortDateString()';
        var noneSportAndLeagueMsg = 'There are no sport events opened on';
    </script>
}
@section Foot {
    <script type="text/javascript" src="~/scripts/_lib/Namespace.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/DatePicker/jquery.nexDatePicker.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/Utils/jquery.fixBugsBrowser.js"></script>
    <script type="text/javascript" src="~/scripts/_lib/MultipleSelect/jquery.multiselect.js"></script>
    <script type="text/javascript" src="~/save-bet/scripts/SaveBetReport.js?v=1"></script>
}
