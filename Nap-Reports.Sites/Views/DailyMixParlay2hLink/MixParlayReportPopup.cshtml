@{
    DateTime reportDate = DateTime.Today;

    int betTypeId = 0;
    string betType = string.Empty;
    var beginSupportMPDate = new DateTime(2011, 11, 15);
    if (Request["reportDate"] != null)
    {
        reportDate = Converter.ToDateTime(Request["reportDate"]);
    }
    else
    {
        reportDate = DateTime.Today;
    }

    if (Request["BetTypeId"] != null)
    {
        betTypeId = Converter.ToInt(Request["BetTypeId"]);
    }

    if (Request["BetType"] != null)
    {
        betType = Converter.ToString2(Request["BetType"]);
    }
}
<script type="text/javascript">
    window.rootUrl = '@Url.Content("~")';
    var moveBetsDay = '@ReportService.BalanceUp.MoveBetsDay.ToShortDateString()';
    var beginSupportMPDate = '@beginSupportMPDate';
    var reportDate = '@reportDate';
    var betType = '@betType';
    var betTypeId = '@betTypeId';
</script>
