FROM hub.nexdev.net/base/dotnet/core/sdk:8.0-alpine AS builder
WORKDIR /src

COPY src/Main/HouseWinLoss/*.csproj ./src/Main/HouseWinLoss/
COPY src/Main/SBPerformance/*.csproj ./src/Main/SBPerformance/
COPY src/Main/SMAWinLoss/*.csproj ./src/Main/SMAWinLoss/
COPY src/Main/TraderPerformanceSoccer/*.csproj ./src/Main/TraderPerformanceSoccer/
COPY src/Misc/AbnormalBet/*.csproj ./src/Misc/AbnormalBet/
COPY src/Misc/Exchange/*.csproj ./src/Misc/Exchange/
COPY src/Misc/ActualMemberBet/*.csproj ./Misc/ActualMemberBet/
COPY src/Misc/CashOutPerformance/*.csproj ./Misc/CashOutPerformance/
COPY src/Misc/UpdatedUsernameCredit/*.csproj ./Misc/UpdatedUsernameCredit/
COPY src/Misc/ResultAnalysis/*.csproj ./Misc/ResultAnalysis/
COPY src/Misc/DailyCreatedCustomers/*.csproj ./Misc/DailyCreatedCustomers/
COPY src/Misc/TotalSMAAndActiveMember/*.csproj ./Misc/TotalSMAAndActiveMember/
COPY src/Misc/CreditMovementMonitor/*.csproj ./Misc/CreditMovementMonitor/
COPY src/Misc/BetCount/*.csproj ./Misc/BetCount/
COPY src/Misc/AutoGeneratedReport/*.csproj ./Misc/AutoGeneratedReport/
COPY src/FraudAndRisk/PunterAnalysis/*.csproj ./FraudAndRisk/PunterAnalysis/
COPY src/FraudAndRisk/Margin/*.csproj ./FraudAndRisk/Margin/
COPY src/FraudAndRisk/ParlayWon/*.csproj ./FraudAndRisk/ParlayWon/
COPY src/FraudAndRisk/SaveBetReport/*.csproj ./FraudAndRisk/SaveBetReport/
COPY src/WinLoss/DailyMixParlay/*.csproj ./src/WinLoss/DailyMixParlay/
COPY src/WinLoss/TreeWinLoss/*.csproj ./src/WinLoss/TreeWinLoss/
COPY src/FraudAndRisk/SBCustomerPerformanceByDanger/*.csproj ./FraudAndRisk/SBCustomerPerformanceByDanger/
COPY src/Shared/Utilities/*.csproj ./src/Shared/Utilities/
COPY src/LegendManagement/LegendManagement/*.csproj ./src/LegendManagement/LegendManagement/
COPY src/Licensee/NegativeBalance/*.csproj ./src/Licensee/NegativeBalance/
COPY src/Licensee/PeakConcurrentUsers/*.csproj ./src/Licensee/PeakConcurrentUsers/
COPY src/Licensee/CompanyWinLoss/*.csproj ./src/Licensee/CompanyWinLoss/
COPY src/Balance/SuperBalance/*.csproj ./src/Balance/SuperBalance/
COPY src/Balance/DirectBalance/*.csproj ./src/Balance/DirectBalance/
COPY src/Balance/CompanyBalanceDifference/*.csproj ./src/Balance/CompanyBalanceDifference/
COPY Nap-Reports.Sites/*.csproj ./Nap-Reports.Sites/


RUN dotnet nuget add source https://nuget.nexdev.net/api/v2
RUN --mount=type=cache,target=/root/.nuget/packages \
    dotnet restore Nap-Reports.Sites/Nap-Reports.Sites.csproj

COPY src ./src
COPY Nap-Reports.Sites ./Nap-Reports.Sites

WORKDIR /src/Nap-Reports.Sites

RUN --mount=type=cache,target=/root/.nuget/packages \
    dotnet publish -c Release -o /app

FROM hub.nexdev.net/base/dotnet/core/aspnet:8.0-alpine AS base

ENV TZ="America/La_Paz" 
ENV COMPlus_EnableDiagnostics=0


# Don’t run as root
RUN adduser --disabled-password \
  --home /app \
  --gecos '' dotnetuser && chown -R dotnetuser /app && chown -R dotnetuser /tmp
USER dotnetuser
#

WORKDIR /app
COPY --from=builder /app .

ENTRYPOINT ["dotnet", "Nap-Reports.Sites.dll"]
